# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAH_REPLACE_ME

# Target chat/channel/group ID. For supergroups/channels it usually starts with -100.
TELEGRAM_CHAT_ID=-1001234567890

# Optional: comma-separated chat IDs for one daily aggregate summary.
# If not set, summary goes to TELEGRAM_CHAT_ID.
SUMMARY_CHAT_IDS=

# Optional paths
CONFIG_PATH=products.yaml
DB_PATH=data/posted.sqlite3

# Optional: comma-separated Telegram user IDs for future admin mode.
# Current MVP does not use this yet, but the planned admin layer will.
ADMIN_IDS=12345678
