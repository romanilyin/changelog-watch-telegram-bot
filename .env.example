# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAH_REPLACE_ME

# Seed file for initial routing state migration (admin/chat/source mapping).
ROUTING_CONFIG_PATH=admin-routing.yaml

# Optional paths
CONFIG_PATH=products.yaml
DB_PATH=data/posted.sqlite3

# Optional: routing/runtime settings
ROUTING_RELOAD_TTL_SECONDS=0
ADMIN_POLL_TIMEOUT=25
ADMIN_COMMAND_POLL_SECONDS=2

# Optional display timezone for release timestamps
DISPLAY_TIMEZONE=Europe/Amsterdam

# Optional GitHub API token to increase rate limits
GITHUB_TOKEN=

# Optional OpenCode Zen one-line summary settings
AI_SUMMARY_ENABLED=false
AI_SUMMARY_API_BASE=https://opencode.ai/zen/v1
AI_SUMMARY_API_KEY=
AI_SUMMARY_MODEL=deepseek-v4-flash-free
AI_SUMMARY_TARGET_LANGUAGE=ru
AI_SUMMARY_MAX_INPUT_CHARS=6000
AI_SUMMARY_TIMEOUT_SECONDS=30
AI_SUMMARY_MAX_OUTPUT_CHARS=220
