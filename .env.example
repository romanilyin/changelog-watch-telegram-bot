# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAH_REPLACE_ME

# Seed file for initial routing state migration (admin/chat/source mapping).
ROUTING_CONFIG_PATH=admin-routing.yaml
# Seed behavior: once = import only when routing DB is empty; sync = re-import every reload; off = never import automatically.
ROUTING_SEED_MODE=once

# Optional paths
CONFIG_PATH=products.yaml
DB_PATH=data/posted.sqlite3
# Recommended repo-local single-instance lock file path.
# Relative paths are resolved from the repository root, not the current shell directory.
BOT_INSTANCE_LOCK_PATH=data/changelog-watch-telegram-bot.lock

# Optional: routing/runtime settings
ROUTING_RELOAD_TTL_SECONDS=0
ADMIN_POLL_TIMEOUT=25
ADMIN_COMMAND_POLL_SECONDS=2

# Optional: admin/process notifications
# ADMIN_IDS controls lifecycle and duplicate-instance admin notifications.
# Routing admin commands are controlled by admin-routing.yaml / SQLite routing state.
ADMIN_IDS=
LIFECYCLE_NOTIFICATIONS_ENABLED=false
DUPLICATE_INSTANCE_NOTIFICATIONS_ENABLED=true

# Legacy compatibility note: TELEGRAM_CHAT_ID is ignored by routing mode.
# Add the target chat_id to admin-routing.yaml instead.
# TELEGRAM_CHAT_ID=

# Optional digest safety settings
SUMMARY_QUEUE_MAX_AGE_DAYS=
SUMMARY_QUEUE_PRUNE_STALE=false

# Optional display timezone for release timestamps
DISPLAY_TIMEZONE=Europe/Amsterdam

# Optional GitHub API token to increase rate limits
GITHUB_TOKEN=

# Optional AI one-line summary settings
AI_SUMMARY_ENABLED=false
AI_SUMMARY_MODELS_CONFIG=ai-summary-models.local.yaml
AI_SUMMARY_API_BASE=https://opencode.ai/zen/v1
AI_SUMMARY_API_KEY=
AI_SUMMARY_MODEL=minimax-m2.5-free
AI_SUMMARY_TARGET_LANGUAGE=ru
AI_SUMMARY_MAX_INPUT_CHARS=6000
AI_SUMMARY_TIMEOUT_SECONDS=30
AI_SUMMARY_MAX_OUTPUT_CHARS=440
AI_SUMMARY_MAX_TOKENS=10000
AI_SUMMARY_DRY_RUN_CALL_API=false
AI_SUMMARY_IN_DIGEST=true
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
